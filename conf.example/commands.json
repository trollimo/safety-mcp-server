{
  "common": {
    "read": {
      "disk_free_all": {
        "description": "Свободное место по всем точкам монтирования",
        "tags": [],
        "pick": "all",
        "cmd": "df -h"
      },
      "disk_free_opt": {
        "description": "Свободное место только для /opt",
        "tags": [],
        "pick": "all",
        "cmd": "df -h /opt"
      },
      "http_server_is_life": {
        "type": "http",
        "description": "Сервер отвечает (жив)",
        "endpoint": "app",
        "method": "GET",
        "path": "/",
        "expect": {
          "status": [
            200
          ]
        }
      },
      "login_form_check": {
        "type": "http",
        "description": "Доступна форма авторизации",
        "endpoint": "app",
        "path": "/login",
        "expect": {
          "status": [
            200
          ],
          "body_contains": "<form",
          "max_ms": 3000
        }
      },
      "sso_health": {
        "type": "http",
        "scope": "global",
        "description": "SSO отвечает (общий для всех стендов)",
        "endpoint": "sso",
        "path": "/health",
        "expect": {
          "status": [
            200
          ]
        }
      }
    },
    "write": {
      "file_create": {
        "description": "Создать пустой файл в каталоге ~/mcp-sandbox (каталог должен существовать)",
        "tags": [],
        "pick": "host",
        "params": {
          "path": {
            "pattern": "mcp-sandbox(/[A-Za-z0-9_][A-Za-z0-9._-]{0,63}){1,4}",
            "description": "Путь к файлу внутри ~/mcp-sandbox, например mcp-sandbox/test.txt"
          }
        },
        "cmd": "touch -- {path}"
      },
      "file_delete": {
        "description": "Удалить файл в каталоге ~/mcp-sandbox (каталоги не удаляет)",
        "tags": [],
        "pick": "host",
        "params": {
          "path": {
            "pattern": "mcp-sandbox(/[A-Za-z0-9_][A-Za-z0-9._-]{0,63}){1,4}",
            "description": "Путь к удаляемому файлу внутри ~/mcp-sandbox"
          }
        },
        "cmd": "rm -f -- {path}"
      }
    }
  },
  "stands": {
    "dev": {
      "read": {
        "swarm_nodes_list": {
          "description": "Список нод Docker Swarm (на manager)",
          "tags": [
            "swarm_manager"
          ],
          "pick": "first",
          "cmd": "sudo -n docker node ls"
        }
      }
    },
    "prod": {}
  }
}
